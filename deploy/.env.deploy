# Deployment Configuration
# Source this file before running deploy scripts:
#   source deploy/.env.deploy

# Google Cloud Project ID
export GCP_PROJECT_ID=koi-market-64433

# Google Cloud Region (choose one close to your users)
# Options: asia-southeast1, asia-east1, us-central1, europe-west1
export GCP_REGION=asia-southeast1

# Firebase Project ID (usually same as GCP project)
export FIREBASE_PROJECT_ID=koi-market-64433

# Database Configuration
export DB_NAME=koi_market
export DB_USER=postgres
export CLOUD_SQL_INSTANCE=koi-market-64433:asia-southeast1:koi-market-db
